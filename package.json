{
  "name": "dgit-cors-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "wrangler dev",
    "dev:portless": "portless run",
    "deploy": "wrangler deploy",
    "lint": "oxlint src scripts tests",
    "lint:fix": "oxlint src scripts tests --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --noEmit --project tests/tsconfig.json"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.90.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  },
  "packageManager": "bun@1.4.2"
}
